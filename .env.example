# CareBridge Environment Variables

# Optional AI API Key (Google Gemini or OpenAI)
# If left empty, CareBridge automatically activates its built-in deterministic clinical NLP fallback engine.
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Mapbox or Custom Map API Key (Leaflet uses OpenStreetMap by default)
NEXT_PUBLIC_MAP_API_KEY=

# Optional Database URL (App runs with client & API in-memory/localStorage for hackathon demo)
DATABASE_URL=
